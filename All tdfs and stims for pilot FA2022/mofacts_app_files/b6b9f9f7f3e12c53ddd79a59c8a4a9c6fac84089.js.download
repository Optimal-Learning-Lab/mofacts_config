trap container div --\x3e\n    <div class="row">\n        <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10">\n            <legend>Mobile Fact and Concept Training System (MoFaCTS):</legend>\n            <ul class="dashed">\n                <li><b>is</b> a system in development that helps students learn information such as facts or concepts.</li>\n                <li><b>is</b> a browser-based web-application, with source code available <a href="https://github.com/memphis-iis/mofacts-ies">here</a>.</li>\n                <li><b>is</b> now available with multiple sample content modules.</li>\n                <li><b>uses</b> a quantitative model of your performance to select an item to learn that will optimally balance the challenge relative to your current ability.</li>\n                <li><b>tracks</b> both prior performance (i.e. past successes and failures) and memory factors, such as recency, frequency, spacing and forgetting.</li>\n                <li><b>saves</b> all of your results to track your learning over multiple sessions.</li>\n                <li><b>was designed</b> by Dr. Philip Pavlik, and many other important collaborators who have been his co-authors, listed <a href="https://www.researchgate.net/profile/Phil_Pavlik_Jr/publications">here</a>.</li>\n                <li><b>was implemented</b> by a series of talented programmers, who are given credit <a href="http://optimallearning.org/mobile-fact-and-concept-training-system-mofacts-beta.html">here</a>.</li>\n                <li><b>can be used</b> to run experiments for collecting controlled data, which is used to create and refine the quantitative model.</li>\n                <li><b>exports</b> data to a convenient format for sharing or analysis <a href="https://datashop.memphis.edu/">here</a>.</li>\n                <li><b>was developed</b> over multiple years with funding from the <a href="http://www.memphis.edu/iis/">IIS</a>, IES: DOED, NSF, and R. Zdrojkowski.</li>\n                <li><b>is explained</b> in this <a href="/ITS2016final.pdf">paper</a> to be presented at the 2016 Intelligent Tutoring Systems Conference.</li>\n            </ul>\n        </div>\n    </div>')}))},"template.tabwarning.js":function e(){Template.__checkName("tabwarning"),Template.tabwarning=new Template("Template.tabwarning",(function(){var e=this;return"This tab has been automatically redirected. Multiple tabs are not allowed. Please continue on your new tab."}))},"template.turkWorkflow.js":function e(){Template.__checkName("turkWorkflow"),Template.turkWorkflow=new Template("Template.turkWorkflow",(function(){var e=this;return[HTML.DIV({id:"turkLogEntireWorkflow"},"\n        ",HTML.DIV({id:"turkLogAll"},"\n            ",HTML.Raw('<div class="row">\n                <div class="col-md-12" id="turkLogSelectContainer">\n                    <legend class="text-center">Select a TDF to see the Turk Log</legend>\n                </div>\n            </div>'),"\n\n            ",Blaze.If((function(){return Spacebars.call(e.lookup("turkExperimentLogToShow"))}),(function(){return["\n            ",HTML.DIV({class:"row"},"\n                ",HTML.DIV({class:"col-md-12 form-inline"},"\n                    ",HTML.LEGEND({class:"text-center"},"\n                        Turk Experiment Log ",HTML.SPAN({id:"turkExpTitle"}),"\n                    "),"\n\n                    ",HTML.DIV({class:"form-group"},"\n                        ",HTML.LABEL({for:"turklog-filt"},"Minimum Trials"),"\n                        ",HTML.INPUT({type:"text",class:"form-control",name:"turklog-filt",id:"turklog-filt",value:"",placeholder:"Only show users with this many trials"}),"\n                    "),"\n\n                    ",HTML.TABLE({class:"table table-striped table-bordered table-condensed",style:"font-size:75%;"},"\n                        ",HTML.THEAD(HTML.TR("\n                            ",HTML.TH("User MongoDB ID"),"\n                            ",HTML.TH("User Name (Turk)"),"\n                            ",HTML.