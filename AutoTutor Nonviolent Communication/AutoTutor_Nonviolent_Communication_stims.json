                "clusterKC": "autotutor.communication-nvc-001.kc.e1",
                "text": "NVC aims to support connection and mutual understanding between people."
              },
              {
                "clusterKC": "autotutor.communication-nvc-001.kc.e2",
                "text": "NVC separates observations from evaluations by describing what was seen or heard instead of leading with interpretations or judgments."
              },
              {
                "clusterKC": "autotutor.communication-nvc-001.kc.e3",
                "text": "NVC distinguishes feelings from thoughts, stories, and interpretations about what another person intended."
              },
              {
                "clusterKC": "autotutor.communication-nvc-001.kc.e4",
                "text": "NVC connects feelings to the speaker's needs or values rather than blaming the other person as the direct cause of the feelings."
              },
              {
                "clusterKC": "autotutor.communication-nvc-001.kc.e5",
                "text": "A need names a broad human value rather than a specific strategy."
              },
              {
                "clusterKC": "autotutor.communication-nvc-001.kc.e6",
                "text": "An NVC request leaves room for the other person to say no."
              },
              {
                "clusterKC": "autotutor.communication-nvc-001.kc.e7",
                "text": "Respectful phrasing does not remove power imbalances."
              }
            ],
