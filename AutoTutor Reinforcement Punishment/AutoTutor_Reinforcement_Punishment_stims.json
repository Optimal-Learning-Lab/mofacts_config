  "setspec": {
    "clusters": [
      {
        "clusterKC": "autotutor.reinforcement-punishment-001.kc.e1",
        "stims": [
          {
            "clusterKC": "autotutor.reinforcement-punishment-001.kc.e1",
            "text": "Reinforcement increases the future likelihood of a behavior; punishment decreases it."
          }
        ]
      },
      {
        "clusterKC": "autotutor.reinforcement-punishment-001.kc.e2",
        "stims": [
          {
            "clusterKC": "autotutor.reinforcement-punishment-001.kc.e2",
            "text": "Positive means a stimulus is added; negative means a stimulus is removed."
          }
        ]
      },
      {
        "clusterKC": "autotutor.reinforcement-punishment-001.kc.e3",
        "stims": [
          {
            "clusterKC": "autotutor.reinforcement-punishment-001.kc.e3",
            "text": "Negative reinforcement removes or avoids an aversive stimulus and increases the behavior that produced that removal."
          }
        ]
      },
      {
        "clusterKC": "autotutor.reinforcement-punishment-001.kc.e4",
        "stims": [
          {
            "clusterKC": "autotutor.reinforcement-punishment-001.kc.e4",
            "text": "The four categories combine stimulus change and behavioral effect: positive reinforcement, negative reinforcement, positive punishment, negative punishment."
          }
        ]
      }
