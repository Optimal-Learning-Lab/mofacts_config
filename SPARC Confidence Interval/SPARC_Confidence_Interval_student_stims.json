{
  "setspec": {
    "clusters": [
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.e1",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.e1",
            "text": "Repeated-sampling interpretation assumes random samples and the same interval-construction method across repetitions."
          }
        ]
      },
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.e2",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.e2",
            "text": "The confidence level describes the long-run proportion of constructed intervals that contain the true population mean."
          }
        ]
      },
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.e3",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.e3",
            "text": "A computed confidence interval either contains the fixed true population mean or it does not."
          }
        ]
      },
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.a",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.a",
            "text": "Construct a confidence interval by extending critical value × standard error on each side of the parameter estimate."
          }
        ]
      },
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.b",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.b",
            "text": "With confidence level and population variability held fixed, margin of error decreases in proportion to 1/√n."
          }
        ]
      },
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.c",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.c",
            "text": "When population standard deviation is unknown and estimated from the sample, a mean interval uses a t multiplier with n − 1 degrees of freedom rather than the known-σ normal multiplier."
          }
        ]
      },
      {
        "clusterKC": "dynamic.stats-confidence-interval-001.kc.d",
        "stims": [
          {
            "clusterKC": "dynamic.stats-confidence-interval-001.kc.d",
            "text": "The normal-approximation proportion interval requires sufficiently many observations in both outcome categories. A large total sample alone is insufficient."
          }
        ]
      }
    ],
