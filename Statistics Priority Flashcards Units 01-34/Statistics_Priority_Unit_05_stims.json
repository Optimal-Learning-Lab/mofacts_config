{
  "setspec": {
    "clusters": [
      {
        "clusterKC": "stats-priority-u05-e93bc45b11ea8b16",
        "stims": [
          {
            "display": {
              "text": "A paired study measuring the same response in each individual before and after a treatment or intervention."
            },
            "response": {
              "correctResponse": "before-and-after study"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-fa4824e83746480e",
        "stims": [
          {
            "display": {
              "text": "A systematic tendency of the data-production or estimation process to overstate or understate the feature being studied."
            },
            "response": {
              "correctResponse": "bias"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-1dadc02a12c78103",
        "stims": [
          {
            "display": {
              "text": "Keeping participants unaware of which treatment they receive to reduce effects of that knowledge on the response."
            },
            "response": {
              "correctResponse": "blinding"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-496aca80e4d8f29f",
        "stims": [
          {
            "display": {
              "text": "A group of experimental subjects with similar values of a relevant background variable, within which treatments are compared."
            },
            "response": {
              "correctResponse": "block"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-5a9cf40c7b2a1649",
        "stims": [
          {
            "display": {
              "text": "Grouping similar experimental subjects according to an important background variable, then randomly assigning treatments within each group."
            },
            "response": {
              "correctResponse": "blocking"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-7969bf2d3a9ceff9",
        "stims": [
          {
            "display": {
              "text": "An attempt to collect data from every individual in the population."
            },
            "response": {
              "correctResponse": "census"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-adbf7988d5d52040",
        "stims": [
          {
            "display": {
              "text": "Randomly selecting groups, or clusters, from the population and including all individuals in the selected groups."
            },
            "response": {
              "correctResponse": "cluster sampling"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-08548dcade68d4ee",
        "stims": [
          {
            "display": {
              "text": "An observation with no missing values on the variables being checked or analyzed."
            },
            "response": {
              "correctResponse": "complete case"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-09cb80eec21371b3",
        "stims": [
          {
            "display": {
              "text": "A sample chosen because its members are easy for the researcher to reach, rather than through a probability sampling plan."
            },
            "response": {
              "correctResponse": "convenience sample"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-46baabb459db8f3d",
        "stims": [
          {
            "display": {
              "text": "A study in which both participants and those evaluating outcomes are unaware of treatment assignments."
            },
            "response": {
              "correctResponse": "double-blind study"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-c63a2e9079237f40",
        "stims": [
          {
            "display": {
              "text": "Values that were not observed or recorded for one or more variables; R represents missing values using NA."
            },
            "response": {
              "correctResponse": "missing data"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-25b88199a733d423",
        "stims": [
          {
            "display": {
              "text": "Selecting a sample in successive stages, such as selecting clusters first and then sampling individuals within those clusters."
            },
            "response": {
              "correctResponse": "multistage sampling"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-d0f1128447803383",
        "stims": [
          {
            "display": {
              "text": "Failure to obtain a response from a selected individual. It can bias results when respondents and nonrespondents differ in relevant ways."
            },
            "response": {
              "correctResponse": "nonresponse"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-6390361dfdff141a",
        "stims": [
          {
            "display": {
              "text": "A numerical characteristic of a population, usually unknown because the entire population has not been measured."
            },
            "response": {
              "correctResponse": "parameter"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-e40655a930cbbe71",
        "stims": [
          {
            "display": {
              "text": "The fraction of all population members having a specified characteristic. Notation: p."
            },
            "response": {
              "correctResponse": "population proportion"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-db338c786a2f5326",
        "stims": [
          {
            "display": {
              "text": "A sampling plan based on random selection, such as simple random, cluster, or stratified sampling."
            },
            "response": {
              "correctResponse": "probability sampling"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-1c7f1db7cfde0477",
        "stims": [
          {
            "display": {
              "text": "Using chance to allocate treatments to individuals or members of a pair, rather than using chance to select the study sample."
            },
            "response": {
              "correctResponse": "random assignment"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-6aef9807eb1bd78c",
        "stims": [
          {
            "display": {
              "text": "The proportion of selected individuals who provide the requested responses."
            },
            "response": {
              "correctResponse": "response rate"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-ccb305e9f06fc7f4",
        "stims": [
          {
            "display": {
              "text": "The arithmetic average of the observed sample values, used to estimate the population mean. Notation: x̄."
            },
            "response": {
              "correctResponse": "sample mean"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-cc1eb6ffa49b0d37",
        "stims": [
          {
            "display": {
              "text": "The fraction of sample members having a specified characteristic, used to estimate the corresponding population proportion. Notation: p̂."
            },
            "response": {
              "correctResponse": "sample proportion"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-c3fa44a62fc27e93",
        "stims": [
          {
            "display": {
              "text": "The number of individuals or observations in a sample. Increasing it generally improves precision but does not remove systematic bias. Notation: n."
            },
            "response": {
              "correctResponse": "sample size"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-325f77805fa1d36c",
        "stims": [
          {
            "display": {
              "text": "A measure of spread of sample values around their sample mean, used to estimate the population standard deviation. Notation: s."
            },
            "response": {
              "correctResponse": "sample standard deviation"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-52630e4131f9862e",
        "stims": [
          {
            "display": {
              "text": "Selecting individuals from a population to provide data for a study."
            },
            "response": {
              "correctResponse": "sampling"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-66ff796802fe623b",
        "stims": [
          {
            "display": {
              "text": "The list or other operational set from which individuals can be selected; it should cover the target population as closely as possible."
            },
            "response": {
              "correctResponse": "sampling frame"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-06299564ef4d0c6c",
        "stims": [
          {
            "display": {
              "text": "The natural variation in a statistic from one random sample to another from the same population."
            },
            "response": {
              "correctResponse": "sampling variability"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-31dc0dd201281182",
        "stims": [
          {
            "display": {
              "text": "Selecting individuals so that a selected individual cannot be chosen again in the same sample."
            },
            "response": {
              "correctResponse": "sampling without replacement"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-7ebcfb714e97b3b0",
        "stims": [
          {
            "display": {
              "text": "A sample of a fixed size selected so that every possible group of that size has the same chance of selection. Abbreviated SRS."
            },
            "response": {
              "correctResponse": "simple random sample"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-e5930e63213247cc",
        "stims": [
          {
            "display": {
              "text": "A numerical summary calculated from a sample, which can vary from sample to sample."
            },
            "response": {
              "correctResponse": "statistic"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-d5621831d4ce85e1",
        "stims": [
          {
            "display": {
              "text": "Dividing the population into strata, taking a random sample from each stratum, and combining the selected observations."
            },
            "response": {
              "correctResponse": "stratified sampling"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-1cc299820a158da5",
        "stims": [
          {
            "display": {
              "text": "Selecting individuals at a regular interval from an ordered list, such as every fiftieth name. The ordering can affect which combinations can be selected."
            },
            "response": {
              "correctResponse": "systematic sampling"
            }
          }
        ]
      },
      {
        "clusterKC": "stats-priority-u05-f2384128f1916803",
        "stims": [
          {
            "display": {
              "text": "A sample formed by people choosing themselves to participate, potentially overrepresenting those with strong interests or opinions. Also called voluntary-response sample."
            },
            "response": {
              "correctResponse": "volunteer sample"
            }
          }
        ]
      }
    ]
  }
}
