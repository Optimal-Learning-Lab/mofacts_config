{
  "setspec": {
    "lessonname": "SPARC American History Progressive",
    "clusters": [
      {
        "clusterid": 0,
        "clustername": "sparc-american-history-progressive-example",
        "stims": [
          {
            "stimulusid": 0,
            "display": {
              "type": "sparc",
              "documentId": "sparc-american-history-progressive",
              "schema": "tutorscript-sparc/1.0",
              "unitType": "sparc-progressive-chapter",
              "layout": {
                "orientation": "progressive-document",
                "zones": [
                  {
                    "id": "chapterFlowBox",
                    "role": "reading-and-realized-path",
                    "region": "left",
                    "flow": "vertical",
                    "ordered": true
                  },
                  {
                    "id": "activityBox",
                    "role": "current-activity",
                    "region": "left",
                    "flow": "vertical",
                    "ordered": true
                  },
                  {
                    "id": "feedbackBox",
                    "role": "feedback-and-remediation",
                    "region": "right",
                    "flow": "vertical",
                    "ordered": true
                  }
                ],
                "frontiers": {
                  "main": {
                    "boxId": "chapterFlowBox",
                    "status": "open"
                  },
                  "activity": {
                    "boxId": "activityBox",
                    "status": "open"
                  }
                }
              },
              "nodes": [
                {
                  "id": "node-intro-paragraph",
                  "nodeType": "group",
                  "groupType": "text-panel",
                  "placement": {
                    "region": "chapterFlowBox",
                    "order": 1
                  },
                  "children": [
                    {
                      "id": "node-intro-text",
                      "nodeType": "atomic",
                      "atomType": "text-block",
                      "value": "In April 1775, tensions between British troops and colonial militia turned into open fighting. The first clashes at Lexington and Concord became a symbolic starting point for the American Revolution."
                    }
                  ]
                },
                {
                  "id": "node-mc-problem",
                  "nodeType": "group",
                  "groupType": "activity-row",
                  "placement": {
                    "region": "activityBox",
                    "order": 1
                  },
                  "label": "Multiple choice",
                  "children": [
                    {
                      "id": "node-mc-question",
                      "nodeType": "atomic",
                      "atomType": "text-block",
                      "value": "Which event marked the beginning of open fighting in the American Revolution?"
                    },
                    {
                      "id": "node-choice-lexington-concord",
                      "nodeType": "atomic",
                      "atomType": "button",
                      "label": "Lexington and Concord",
                      "value": "Lexington and Concord",
                      "variant": "green"
                    },
                    {
                      "id": "node-choice-bunker-hill",
                      "nodeType": "atomic",
                      "atomType": "button",
                      "label": "Bunker Hill",
                      "value": "Bunker Hill"
                    },
                    {
                      "id": "node-choice-declaration",
                      "nodeType": "atomic",
                      "atomType": "button",
                      "label": "Declaration of Independence",
                      "value": "Declaration of Independence"
                    },
                    {
                      "id": "node-choice-saratoga",
                      "nodeType": "atomic",
                      "atomType": "button",
                      "label": "Saratoga",
                      "value": "Saratoga"
                    }
                  ]
                },
                {
                  "id": "node-feedback-panel",
                  "nodeType": "group",
                  "groupType": "feedback-panel",
                  "placement": {
                    "region": "feedbackBox",
                    "order": 1
                  },
                  "children": [
                    {
                      "id": "node-feedback-message",
                      "nodeType": "atomic",
                      "atomType": "message-box",
                      "value": ""
                    }
                  ]
                }
              ],
              "behavior": {
                "schema": "sparc-behavior/1.0",
                "orderPolicy": "progressive",
                "responseFormalism": "SAI",
                "steps": [
                  {
                    "id": "answer-opening-multiple-choice",
                    "responses": [
                      {
                        "selection": "choiceLexingtonConcord",
                        "action": "ButtonPressed",
                        "input": "Lexington and Concord",
                        "nodeRef": "node-choice-lexington-concord",
                        "modelTarget": "american-revolution-opening"
                      },
                      {
                        "selection": "choiceBunkerHill",
                        "action": "ButtonPressed",
                        "input": "Bunker Hill",
                        "nodeRef": "node-choice-bunker-hill",
                        "modelTarget": "american-revolution-opening"
                      },
                      {
                        "selection": "choiceDeclaration",
                        "action": "ButtonPressed",
                        "input": "Declaration of Independence",
                        "nodeRef": "node-choice-declaration",
                        "modelTarget": "american-revolution-opening"
                      },
                      {
                        "selection": "choiceSaratoga",
                        "action": "ButtonPressed",
                        "input": "Saratoga",
                        "nodeRef": "node-choice-saratoga",
                        "modelTarget": "american-revolution-opening"
                      }
                    ]
                  },
                  {
                    "id": "answer-challenge-fill-in",
                    "responses": [
                      {
                        "selection": "challengeYorktown",
                        "action": "UpdateTextArea",
                        "input": "Yorktown",
                        "nodeRef": "node-challenge-answer",
                        "modelTarget": "american-revolution-yorktown"
                      }
                    ]
                  }
                ]
              },
              "workingMemoryFacts": [
                {
                  "factType": "frontier",
                  "slots": {
                    "name": "main",
                    "boxId": "chapterFlowBox",
                    "status": "open"
                  }
                },
                {
                  "factType": "frontier",
                  "slots": {
                    "name": "activity",
                    "boxId": "activityBox",
                    "status": "open"
                  }
                }
              ],
              "productionRules": [
                {
                  "id": "history.mc.correct.lexington-concord",
                  "module": "american-history-progressive",
                  "salience": 20,
                  "when": [
                    {
                      "factType": "interface-event",
                      "slots": {
                        "documentId": {
                          "type": "bind",
                          "variable": "documentId"
                        },
                        "selection": {
                          "type": "literal",
                          "value": "choiceLexingtonConcord"
                        },
                        "action": {
                          "type": "literal",
                          "value": "ButtonPressed"
                        },
                        "input": {
                          "type": "literal",
                          "value": "Lexington and Concord"
                        }
                      }
                    }
                  ],
                  "then": [
                    {
                      "type": "classify",
                      "outcome": "correct"
                    },
                    {
                      "type": "message",
                      "messageType": "success",
                      "template": "Correct. Lexington and Concord were the first open clashes of the Revolution.",
                      "target": {
                        "documentId": {
                          "type": "variable",
                          "name": "documentId"
                        },
                        "nodeId": {
                          "type": "literal",
                          "value": "node-feedback-message"
                        }
                      }
                    },
                    {
                      "type": "append-node",
                      "frontier": "activity",
                      "boxId": "activityBox",
                      "node": {
                        "id": "node-challenge-yorktown",
                        "nodeType": "group",
                        "groupType": "activity-row",
                        "placement": {
                          "region": "activityBox"
                        },
                        "label": "Challenge",
                        "children": [
                          {
                            "id": "node-challenge-question",
                            "nodeType": "atomic",
                            "atomType": "text-block",
                            "value": "Challenge: Which 1781 battle effectively ended major fighting in the American Revolution?"
                          },
                          {
                            "id": "node-challenge-answer",
                            "nodeType": "atomic",
                            "atomType": "text-input",
                            "value": "",
                            "hint": "Battle name",
                            "expected": "Yorktown"
                          }
                        ]
                      }
                    },
                    {
                      "type": "credit",
                      "kc": "american-revolution-opening"
                    }
                  ]
                },
                {
                  "id": "history.mc.incorrect.bunker-hill",
                  "module": "american-history-progressive",
                  "salience": 10,
                  "when": [
                    {
                      "factType": "interface-event",
                      "slots": {
                        "documentId": {
                          "type": "bind",
                          "variable": "documentId"
                        },
                        "selection": {
                          "type": "literal",
                          "value": "choiceBunkerHill"
                        },
                        "action": {
                          "type": "literal",
                          "value": "ButtonPressed"
                        },
                        "input": {
                          "type": "literal",
                          "value": "Bunker Hill"
                        }
                      }
                    }
                  ],
                  "then": [
                    {
                      "type": "classify",
                      "outcome": "incorrect"
                    },
                    {
                      "type": "message",
                      "messageType": "feedback",
                      "template": "Bunker Hill came later in 1775. Look back at the first clashes.",
                      "target": {
                        "documentId": {
                          "type": "variable",
                          "name": "documentId"
                        },
                        "nodeId": {
                          "type": "literal",
                          "value": "node-feedback-message"
                        }
                      }
                    },
                    {
                      "type": "append-node",
                      "frontier": "main",
                      "boxId": "chapterFlowBox",
                      "node": {
                        "id": "node-remediation-bunker-hill",
                        "nodeType": "atomic",
                        "atomType": "text-block",
                        "placement": {
                          "region": "chapterFlowBox"
                        },
                        "value": "Remediation: Bunker Hill was an early major battle, but the war had already begun at Lexington and Concord."
                      }
                    }
                  ]
                },
                {
                  "id": "history.mc.incorrect.declaration",
                  "module": "american-history-progressive",
                  "salience": 10,
                  "when": [
                    {
                      "factType": "interface-event",
                      "slots": {
                        "documentId": {
                          "type": "bind",
                          "variable": "documentId"
                        },
                        "selection": {
                          "type": "literal",
                          "value": "choiceDeclaration"
                        },
                        "action": {
                          "type": "literal",
                          "value": "ButtonPressed"
                        },
                        "input": {
                          "type": "literal",
                          "value": "Declaration of Independence"
                        }
                      }
                    }
                  ],
                  "then": [
                    {
                      "type": "classify",
                      "outcome": "incorrect"
                    },
                    {
                      "type": "message",
                      "messageType": "feedback",
                      "template": "The Declaration came in 1776, after fighting had already started.",
                      "target": {
                        "documentId": {
                          "type": "variable",
                          "name": "documentId"
                        },
                        "nodeId": {
                          "type": "literal",
                          "value": "node-feedback-message"
                        }
                      }
                    },
                    {
                      "type": "append-node",
                      "frontier": "main",
                      "boxId": "chapterFlowBox",
                      "node": {
                        "id": "node-remediation-declaration",
                        "nodeType": "atomic",
                        "atomType": "text-block",
                        "placement": {
                          "region": "chapterFlowBox"
                        },
                        "value": "Remediation: The Declaration of Independence stated the colonies' break with Britain, but it was not the first fighting."
                      }
                    }
                  ]
                },
                {
                  "id": "history.mc.incorrect.saratoga",
                  "module": "american-history-progressive",
                  "salience": 10,
                  "when": [
                    {
                      "factType": "interface-event",
                      "slots": {
                        "documentId": {
                          "type": "bind",
                          "variable": "documentId"
                        },
                        "selection": {
                          "type": "literal",
                          "value": "choiceSaratoga"
                        },
                        "action": {
                          "type": "literal",
                          "value": "ButtonPressed"
                        },
                        "input": {
                          "type": "literal",
                          "value": "Saratoga"
                        }
                      }
                    }
                  ],
                  "then": [
                    {
                      "type": "classify",
                      "outcome": "incorrect"
                    },
                    {
                      "type": "message",
                      "messageType": "feedback",
                      "template": "Saratoga was a turning point in 1777, not the start of open fighting.",
                      "target": {
                        "documentId": {
                          "type": "variable",
                          "name": "documentId"
                        },
                        "nodeId": {
                          "type": "literal",
                          "value": "node-feedback-message"
                        }
                      }
                    },
                    {
                      "type": "append-node",
                      "frontier": "main",
                      "boxId": "chapterFlowBox",
                      "node": {
                        "id": "node-remediation-saratoga",
                        "nodeType": "atomic",
                        "atomType": "text-block",
                        "placement": {
                          "region": "chapterFlowBox"
                        },
                        "value": "Remediation: Saratoga helped bring France into the war, but Lexington and Concord came first."
                      }
                    }
                  ]
                },
                {
                  "id": "history.challenge.correct.yorktown",
                  "module": "american-history-progressive",
                  "salience": 20,
                  "when": [
                    {
                      "factType": "interface-event",
                      "slots": {
                        "documentId": {
                          "type": "bind",
                          "variable": "documentId"
                        },
                        "selection": {
                          "type": "literal",
                          "value": "challengeYorktown"
                        },
                        "action": {
                          "type": "literal",
                          "value": "UpdateTextArea"
                        },
                        "input": {
                          "type": "literal",
                          "value": "Yorktown"
                        }
                      }
                    }
                  ],
                  "then": [
                    {
                      "type": "classify",
                      "outcome": "correct"
                    },
                    {
                      "type": "write-state",
                      "write": {
                        "target": {
                          "documentId": {
                            "type": "variable",
                            "name": "documentId"
                          },
                          "nodeId": {
                            "type": "literal",
                            "value": "node-challenge-answer"
                          }
                        },
                        "key": "value",
                        "value": {
                          "type": "literal",
                          "value": "Yorktown"
                        }
                      }
                    },
                    {
                      "type": "message",
                      "messageType": "success",
                      "template": "Correct. The Battle of Yorktown in 1781 effectively ended major fighting.",
                      "target": {
                        "documentId": {
                          "type": "variable",
                          "name": "documentId"
                        },
                        "nodeId": {
                          "type": "literal",
                          "value": "node-feedback-message"
                        }
                      }
                    },
                    {
                      "type": "credit",
                      "kc": "american-revolution-yorktown"
                    }
                  ]
                }
              ],
              "response": {
                "gradingMode": "node-intent",
                "evaluation": {
                  "trimWhitespace": true,
                  "ignoreCase": true
                },
                "scoredNodes": [
                  "node-choice-lexington-concord"
                ],
                "intentByNode": [
                  {
                    "node": "node-choice-lexington-concord",
                    "expected": "Lexington and Concord"
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
