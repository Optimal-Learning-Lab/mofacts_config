{
  "setspec": {
    "clusters": [
      {
        "clusterKC": "autotutor.special-relativity-001.kc.e1",
        "stims": [
          {
            "clusterKC": "autotutor.special-relativity-001.kc.e1",
            "text": "Special relativity compares inertial frames moving at constant velocity relative to one another."
          }
        ]
      },
      {
        "clusterKC": "autotutor.special-relativity-001.kc.e2",
        "stims": [
          {
            "clusterKC": "autotutor.special-relativity-001.kc.e2",
            "text": "All inertial observers measure light in vacuum as having the same speed."
          }
        ]
      },
      {
        "clusterKC": "autotutor.special-relativity-001.kc.e3",
        "stims": [
          {
            "clusterKC": "autotutor.special-relativity-001.kc.e3",
            "text": "For defined event pairs, an observer measures a moving clock as having less elapsed proper time than the coordinate time in that observer's frame."
          }
        ]
      },
      {
        "clusterKC": "autotutor.special-relativity-001.kc.e4",
        "stims": [
          {
            "clusterKC": "autotutor.special-relativity-001.kc.e4",
            "text": "Distant events that are simultaneous in one inertial frame may not be simultaneous in another moving inertial frame."
          }
        ]
      },
      {
        "clusterKC": "autotutor.special-relativity-001.kc.e5",
        "stims": [
          {
            "clusterKC": "autotutor.special-relativity-001.kc.e5",
            "text": "Relativistic time effects are not merely visual delays, perception errors, or defective clocks; they are coordinate measurements confirmed by experiments."
          }
        ]
      }
    ],
