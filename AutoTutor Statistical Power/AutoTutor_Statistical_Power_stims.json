{
  "setspec": {
    "clusters": [
      {
        "clusterKC": "autotutor.statistical-power-001.kc.e1",
        "stims": [
          {
            "clusterKC": "autotutor.statistical-power-001.kc.e1",
            "text": "Power is the probability that a test rejects the null if a specified alternative effect is truly present."
          }
        ]
      },
      {
        "clusterKC": "autotutor.statistical-power-001.kc.e2",
        "stims": [
          {
            "clusterKC": "autotutor.statistical-power-001.kc.e2",
            "text": "A power value is defined for a particular effect size, alpha level, sample size, variability, and statistical test or analysis plan."
          }
        ]
      },
      {
        "clusterKC": "autotutor.statistical-power-001.kc.e3",
        "stims": [
          {
            "clusterKC": "autotutor.statistical-power-001.kc.e3",
            "text": "An 80% power statement means that repeated studies under the assumed conditions would reject the null about 80% of the time."
          }
        ]
      },
      {
        "clusterKC": "autotutor.statistical-power-001.kc.e4",
        "stims": [
          {
            "clusterKC": "autotutor.statistical-power-001.kc.e4",
            "text": "Power is not the probability that the research hypothesis is true or that a significant result is true."
          }
        ]
      },
      {
        "clusterKC": "autotutor.statistical-power-001.kc.e5",
        "stims": [
          {
            "clusterKC": "autotutor.statistical-power-001.kc.e5",
            "text": "Larger samples generally increase power for a given effect, while smaller target effects require larger samples to detect with the same power."
          }
        ]
      }
    ],
